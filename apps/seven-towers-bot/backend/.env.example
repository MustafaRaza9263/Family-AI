PORT=4000
NODE_ENV=development
LOG_LEVEL=info

LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=qwen3.6
LLM_API_KEY=replace-me
LLM_CONTEXT_TOKENS=32768
LLM_TIMEOUT_MS=90000

MONGODB_URI=mongodb://mongoadmin:CHANGE_ME@127.0.0.1:27017/seven_towers_bot?authSource=admin
MONGODB_URI_TEST=mongodb://mongoadmin:CHANGE_ME@127.0.0.1:27017/seven_towers_bot_test?authSource=admin

SESSION_TTL_DAYS=7
COOKIE_NAME=sid
DEFAULT_PHONE_REGION=PK
DEFAULT_PROJECT_ID=seven-towers
KNOWLEDGE_DIR=./knowledge

# Comma-separated Origins allowed in addition to same-host.
# Required in dev when the UI is on :3000 and the API on :4000 (Next rewrites).
# Production (UI served from Express on :4000) can leave this empty.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://spark-beee.local:3000,http://spark-beee.local:4000,http://spark-beee.tail811701.ts.net:3000,http://spark-beee.tail811701.ts.net:4000

# Next.js static export directory (relative to backend cwd)
FRONTEND_DIST_DIR=../frontend/out
