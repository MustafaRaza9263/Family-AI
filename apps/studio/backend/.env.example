NODE_ENV=development
PORT=4001
LOG_LEVEL=info

# Same Mongo container as seven-towers-bot; separate database name `studio`.
# Use the same root user/password as apps/seven-towers-bot/backend/.env.
# Host stays 127.0.0.1 for local `npm run` / seed (Mongo is bound to 127.0.0.1:27017).
# Compose overrides the URI host to `mongo` on network `company-ai`.
MONGODB_URI=mongodb://mongoadmin:CHANGE_ME@127.0.0.1:27017/studio?authSource=admin

SESSION_COOKIE_NAME=studio_sid
SESSION_TTL_DAYS=14
TRUST_PROXY=0
CORS_ORIGIN=http://localhost:3001
DATA_DIR=./data
COMFY_URL=http://127.0.0.1:8188
RECIPES_DIR=./recipes

# Per-job hardware/node metrics (collection job_metrics).
TELEMETRY_ENABLED=true
TELEMETRY_SAMPLE_INTERVAL_MS=1000
TELEMETRY_RETENTION_DAYS=90

# Usage day boundary and asset soft-delete age.
STUDIO_TIMEZONE=UTC
RETENTION_DAYS=30
ENGINE_PING_INTERVAL_MS=10000
