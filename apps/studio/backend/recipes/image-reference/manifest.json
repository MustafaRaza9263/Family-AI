{
  "id": "image-reference",
  "tool": "image",
  "timeoutSeconds": 300,
  "match": {
    "tool": "image",
    "inputImages": {
      "min": 2,
      "max": 4
    },
    "label": "Combine",
    "placeholder": "Describe how to combine them, e.g. the person in the first image in the scene of the second image"
  },
  "params": {
    "prompt": {
      "type": "text",
      "label": "Prompt",
      "group": "primary",
      "maxLength": 1000,
      "target": {
        "title": "IN_PROMPT",
        "fields": [
          "value"
        ]
      }
    },
    "aspectRatio": {
      "type": "enum",
      "label": "Aspect ratio",
      "icon": "ratio",
      "group": "primary",
      "default": "1:1",
      "options": [
        {
          "value": "1:1",
          "label": "Square",
          "icon": "square",
          "sizes": {
            "width": 1024,
            "height": 1024
          }
        },
        {
          "value": "4:5",
          "label": "Portrait",
          "icon": "rectangle-vertical",
          "sizes": {
            "width": 896,
            "height": 1120
          }
        },
        {
          "value": "16:9",
          "label": "Landscape",
          "icon": "rectangle-horizontal",
          "sizes": {
            "width": 1344,
            "height": 768
          }
        },
        {
          "value": "9:16",
          "label": "Story",
          "icon": "smartphone",
          "sizes": {
            "width": 768,
            "height": 1344
          }
        }
      ],
      "target": {
        "title": "IN_SIZE",
        "fields": [
          "width",
          "height"
        ]
      }
    }
  },
  "seed": {
    "target": {
      "title": "IN_SAMPLER",
      "fields": [
        "seed"
      ]
    }
  },
  "output": {
    "title": "OUT_IMAGE",
    "prefixField": "filename_prefix"
  },
  "images": [
    {
      "title": "IN_IMAGE_1",
      "field": "image"
    },
    {
      "title": "IN_IMAGE_2",
      "field": "image"
    },
    {
      "title": "IN_IMAGE_3",
      "field": "image",
      "detach": [
        {
          "title": "IN_IMAGE_BATCH",
          "input": "images.image2"
        },
        {
          "title": "IN_REFERENCES",
          "input": "images.image2"
        }
      ]
    },
    {
      "title": "IN_IMAGE_4",
      "field": "image",
      "detach": [
        {
          "title": "IN_IMAGE_BATCH",
          "input": "images.image3"
        },
        {
          "title": "IN_REFERENCES",
          "input": "images.image3"
        }
      ]
    }
  ]
}