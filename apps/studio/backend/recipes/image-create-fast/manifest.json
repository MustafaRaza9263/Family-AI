{
  "id": "image-create-fast",
  "tool": "image",
  "timeoutSeconds": 120,
  "match": {
    "tool": "image",
    "inputImages": { "min": 0, "max": 0 },
    "label": "Create",
    "placeholder": "Describe the image you want",
    "variant": {
      "id": "fast",
      "label": "Fast",
      "icon": "zap",
      "default": true
    }
  },
  "params": {
    "prompt": {
      "type": "text",
      "label": "Prompt",
      "group": "primary",
      "maxLength": 1000,
      "target": { "title": "IN_PROMPT", "fields": ["text"] }
    },
    "aspectRatio": {
      "type": "enum",
      "label": "Aspect ratio",
      "group": "primary",
      "default": "1:1",
      "options": [
        {
          "value": "1:1",
          "label": "Square 1:1",
          "sizes": { "width": 1024, "height": 1024 }
        },
        {
          "value": "4:5",
          "label": "Portrait 4:5",
          "sizes": { "width": 896, "height": 1120 }
        },
        {
          "value": "16:9",
          "label": "Landscape 16:9",
          "sizes": { "width": 1344, "height": 768 }
        },
        {
          "value": "9:16",
          "label": "Story 9:16",
          "sizes": { "width": 768, "height": 1344 }
        }
      ],
      "target": { "title": "IN_SIZE", "fields": ["width", "height"] }
    }
  },
  "seed": {
    "target": { "title": "IN_SAMPLER", "fields": ["seed"] }
  },
  "output": {
    "title": "OUT_IMAGE",
    "prefixField": "filename_prefix"
  }
}
